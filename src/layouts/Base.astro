---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import Chrome from '../components/Chrome.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = '/og/home.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="cherry">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jevinsidhu" />
    <link rel="preload" href="/fonts/Casserole-Classic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf7f5" />
    <!-- Apply the saved theme before first paint so there's no flash. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('js-theme');
        if (t && /^(cherry|maple|ocean|matcha|grape)$/.test(t)) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <slot />
    <Chrome />
  </body>
</html>

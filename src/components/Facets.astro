---
/* The Facets of Quality, set as a definition list rather than cards: term in
   the left column, the promise beside it, hairlines only between the rows.
   Same ledger language as the Detail specimens further down the section. */
interface Props { items: { title: string; desc: string }[] }
const { items } = Astro.props;
---
<dl class="facets">
  {items.map((f) => (
    <div class="row">
      <dt>{f.title}</dt>
      <dd>{f.desc}</dd>
    </div>
  ))}
</dl>

<style>
  .facets { margin: 20px 0 30px; }
  .row {
    display: grid; grid-template-columns: 136px minmax(0, 1fr); gap: 20px;
    align-items: baseline; padding: 13px 0;
  }
  .row + .row { border-top: 1px solid var(--line2); }
  dt { font: 600 15.5px var(--font-sans); color: var(--ink); }
  dd { font: 14.5px/1.65 var(--font-sans); color: var(--t2); margin: 0; text-wrap: pretty; }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; gap: 4px; padding: 12px 0; }
  }
</style>

---
interface Props { id: string; title?: string; principle?: number }
const { id, title, principle } = Astro.props;
const WORDS = ['one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
const word = principle ? WORDS[principle - 1] : '';
---
<section id={id} class="sec">
  <div class="body">
    {principle && <div class="prin">Principle {word}</div>}
    {title && <h2>{title}</h2>}
    <slot />
  </div>
  <slot name="note" />
</section>

<style>
  .sec { position: relative; }
  .sec h2 { font: 600 26px/1.25 var(--font-sans); letter-spacing: -.02em; color: var(--ink); margin: 56px 0 18px; }
  /* principle chip: quiet ticket above each principle heading */
  .prin {
    display: inline-block; margin: 56px 0 0; padding: 5px 11px 4px;
    border: 1.5px solid color-mix(in srgb, var(--acc) 45%, transparent); border-radius: 99px;
    background: color-mix(in srgb, var(--acc) 9%, var(--card));
    font: 600 12px var(--font-sans); letter-spacing: .02em; color: var(--acc);
  }
  .prin + h2 { margin-top: 16px; }
  .body :global(h3) { font: 600 19px/1.3 var(--font-sans); letter-spacing: -.015em; color: var(--ink); margin: 44px 0 12px; }
  .body :global(h4) { font: 600 16.5px/1.8 var(--font-sans); color: var(--ink); margin: 30px 0 8px; }
  .body :global(p) { font: 16.5px/1.8 var(--font-sans); color: var(--t1); margin: 0 0 18px; }
  .body :global(p a) { color: var(--ink); text-decoration: underline; text-decoration-color: rgba(var(--accrgb), .6); text-underline-offset: 3px; }
  /* the explicit colour above out-ranks the global a:hover, so state it here */
  .body :global(p a:hover) { color: var(--acc); text-decoration-color: var(--acc); }
  /* the pull-quote: same words, its own stage — the wavy underline inks in on scroll */
  .body :global(.pmf) {
    display: block; margin: 20px 0 18px; text-wrap: balance;
    font: 500 26px/1.45 var(--font-serif); font-style: italic; letter-spacing: -.01em; color: var(--ink);
    text-decoration: underline wavy transparent 2.5px; text-underline-offset: 8px;
    transition: text-decoration-color 1s ease .25s;
  }
  .body :global(.pmf[data-run]) { text-decoration-color: rgba(var(--accrgb), .85); }
  .body :global(.pmf-attr) { display: block; margin-top: 12px; font: 13px var(--font-sans); color: var(--t3); }
  .body :global(figure + p), .body :global(.phones + p), .body :global(.row + p) { margin-top: 34px; }
  .body :global(.phones + h3), .body :global(figure + h3) { margin-top: 48px; }
  .body :global(p:last-child) { margin-bottom: 0; }
  .body :global(blockquote) {
    border: 0; margin: 36px 0; padding: 0; font: 500 27px/1.35 var(--font-sans); letter-spacing: -.02em; color: var(--ink);
  }
  .body :global(blockquote p) { font: inherit; color: inherit; margin: 0; }
  .body :global(blockquote cite) {
    display: block; font: 12px var(--font-mono); color: var(--t4); margin-top: 12px; letter-spacing: .06em; font-style: normal;
  }
</style>

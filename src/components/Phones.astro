---
/* A row of muted looping videos in phone frames (square or portrait), each
   with a small label. Videos play only while on screen (post.ts). */
interface Props {
  items: { src: string; poster: string; label?: string; portrait?: boolean }[];
  size?: 'sm' | 'md';
}
const { items, size = 'md' } = Astro.props;
---
<div class:list={['phones', size]} style={`--n:${items.length}`}>
  {items.map((it) => (
    <figure class:list={['ph', { portrait: it.portrait }]} data-shine="soft">
      <div class="frame"><video src={it.src} poster={it.poster} muted loop playsinline preload="metadata"></video></div>
      {it.label && <figcaption>{it.label}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .phones { display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 18px; margin: 26px 0 0; }
  /* lone portrait recordings stay capped; square singles span the column */
  .phones[style*="--n:1"] .portrait { max-width: 300px; }
  .ph { margin: 0; min-width: 0; position: relative; }
  .frame { border-radius: 22px; overflow: hidden; background: #111; border: 1.5px solid var(--line); box-shadow: 0 10px 30px rgba(60,40,20,.10); transition: transform .35s var(--ease-pop), box-shadow .35s; }
  .ph:hover .frame { transform: translateY(-3px) rotate(-.4deg); box-shadow: 0 18px 44px rgba(60,40,20,.16); }
  video { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .portrait video { aspect-ratio: 1206 / 2622; }
  figcaption { font: 11px var(--font-sans); color: var(--t5); margin-top: 10px; }
  .sm .frame { border-radius: 16px; }
  @media (max-width: 640px) {
    .phones { grid-template-columns: 1fr 1fr; }
    .phones[style*="--n:1"] { grid-template-columns: 1fr; } /* singles span the width on mobile too */
  }
</style>

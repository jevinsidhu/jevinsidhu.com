---
/* A proper little player for a video that has a voice track: poster with a
   big play button, progress bar, time, and a sound toggle. Starts on click
   (so audio is allowed) and pauses when scrolled away. Logic in gadgets.ts. */
interface Props { src: string; poster: string; caption?: string }
const { src, poster, caption } = Astro.props;
---
<figure class="player" data-player>
  <div class="screen">
    <video src={src} poster={poster} playsinline preload="metadata" muted autoplay></video>
    <img class="vposter" src={poster} alt="" aria-hidden="true" decoding="async" />
    <button type="button" class="big" data-play aria-label="Turn sound on" data-hot>
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M2 6h2.5L8 3v10L4.5 10H2z" fill="currentColor"/><path d="M10.5 5.5a3.5 3.5 0 010 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M12.5 3.8a6 6 0 010 8.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      <span>Tap for sound</span>
    </button>
    <div class="bar">
      <button type="button" class="ic" data-toggle aria-label="Play / pause" data-hot>
        <svg class="ic-play" width="14" height="14" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
        <svg class="ic-pause" width="14" height="14" viewBox="0 0 24 24"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"/></svg>
      </button>
      <div class="track" data-track><div class="fill" data-fill></div></div>
      <span class="time" data-time>0:00</span>
      <button type="button" class="ic" data-mute aria-label="Mute / unmute" data-hot>
        <svg class="ic-snd" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2 6h2.5L8 3v10L4.5 10H2z" fill="currentColor"/><path d="M10.5 5.5a3.5 3.5 0 010 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <svg class="ic-mut" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2 6h2.5L8 3v10L4.5 10H2z" fill="currentColor"/><path d="M10.5 6l4 4M14.5 6l-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* Theatre mode: break out of the article column and run (nearly) edge to
     edge, centred to the viewport. The column itself is centred, so a
     negative inline margin of half the difference does it. */
  .player {
    --tw: min(1200px, calc(100vw - 80px));
    width: var(--tw);
    margin: 44px calc((100% - var(--tw)) / 2) 16px;
  }
  @media (max-width: 780px) { .player { --tw: calc(100vw - 32px); } }
  .screen { position: relative; border-radius: 16px; overflow: hidden; background: #111; border: 1.5px solid var(--line); box-shadow: 0 18px 60px rgba(60, 40, 20, .14); }
  video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; cursor: pointer; }
  .vposter { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; transition: opacity .3s ease; }
  .vposter[data-hide] { opacity: 0; }
  .big {
    position: absolute; inset: 0; margin: auto; width: max-content; height: 48px; padding: 0 22px 0 16px;
    display: flex; align-items: center; gap: 10px; border: 0; border-radius: 99px; cursor: pointer;
    font: 600 13.5px var(--font-sans); color: #1a1410; background: rgba(255,255,255,.92);
    box-shadow: 0 10px 30px rgba(0,0,0,.35); transition: transform .25s var(--ease-pop), opacity .25s;
  }
  .big:hover { transform: scale(1.04); }
  .player[data-started] .big { opacity: 0; pointer-events: none; transform: scale(.9); }
  .bar {
    position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 10px; padding: 12px 14px;
    background: linear-gradient(transparent, rgba(0,0,0,.55)); color: #fff; opacity: 0; transition: opacity .3s;
  }
  .player[data-started] .screen:hover .bar, .player[data-started]:not([data-playing]) .bar { opacity: 1; }
  .ic { width: 30px; height: 30px; display: grid; place-items: center; border: 0; border-radius: 50%; background: rgba(255,255,255,.16); color: #fff; cursor: pointer; }
  .ic:hover { background: rgba(255,255,255,.28); }
  .ic svg { display: block; }
  .ic svg.ic-pause, .ic svg.ic-mut { display: none; } /* must out-rank `.ic svg` under Astro's scoping */
  .player[data-playing] .ic-play { display: none; }
  .player[data-playing] .ic-pause { display: block; }
  .player[data-muted] .ic-snd { display: none; }
  .player[data-muted] .ic-mut { display: block; }
  .track { flex: 1; height: 4px; border-radius: 2px; background: rgba(255,255,255,.28); cursor: pointer; position: relative; }
  .track::before { content: ''; position: absolute; inset: -10px 0; }
  .fill { height: 100%; width: 0; border-radius: 2px; background: var(--acc); }
  .time { font: 11px var(--font-mono); min-width: 72px; text-align: right; font-variant-numeric: tabular-nums; }
  figcaption { font: 11px var(--font-sans); color: var(--t5); margin-top: 12px; text-align: center; }
</style>

---
/* The sign-off that closes a case study: the same ink autograph that shows
   up as a margin doodle earlier now actually signs the piece, with the
   author's name, the date, and a quiet row of links beneath. Draws in on
   scroll via the shared [data-sketch]/[data-run] machinery. */
interface Props { name: string; date: string }
const { name, date } = Astro.props;
---
<div class="signoff" data-sketch>
  <svg class="sig" viewBox="0 0 180 108" width="172" role="img" aria-label={`Signed, ${name}`}>
    <path class="dr" style="--d:.2s" pathLength="1"
      d="M14 72 C 20 30, 38 28, 37 54 C 36 72, 24 80, 20 71 C 16 62, 32 54, 46 58 C 58 61, 60 72, 71 64 S 87 44, 93 59 C 97 70, 106 68, 114 58 C 121 49, 127 56, 133 63 Q 141 70, 154 58" />
    <path class="dr swash" style="--d:1.3s" pathLength="1" d="M24 88 Q 96 102 168 80 q -22 12 -44 12" />
  </svg>
  <div class="who">{name}</div>
  <div class="when">{date}</div>
</div>

<style>
  .signoff { margin: 57px 0 0; --pencil: color-mix(in srgb, color-mix(in srgb, var(--acc) 40%, var(--ink)) 62%, transparent); }
  .sig { display: block; margin-left: -6px; }
  .dr {
    fill: none; stroke: color-mix(in srgb, var(--acc) 78%, var(--ink));
    stroke-width: 2.1; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 1 2; stroke-dashoffset: 0; /* drawn unless JS arms it */
  }
  .signoff[data-armed] .dr { stroke-dashoffset: 1.02; }
  .swash { stroke-width: 1.9; }
  .signoff[data-run] .dr {
    animation-name: sodraw; animation-duration: .6s; animation-fill-mode: forwards;
    animation-timing-function: cubic-bezier(.45, 0, .3, 1); animation-delay: var(--d, 0s);
  }
  @keyframes sodraw { to { stroke-dashoffset: 0; } }

  .who { font: 600 15px var(--font-sans); color: var(--ink); margin-top: 10px; }
  .when { font: 14px var(--font-sans); color: var(--t3); margin-top: 3px; }

  /* name/date/links are real content — never gated behind an observer */

  @media (prefers-reduced-motion: reduce) {
    .dr, .signoff[data-armed] .dr, .signoff[data-run] .dr { animation: none; stroke-dashoffset: 0; }
  }
</style>

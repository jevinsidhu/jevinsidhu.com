---
/* Image, muted looping video, or a striped placeholder — with a caption.
   Videos get 1x / 0.5x playback toggles via post.ts. Several Figures can
   sit side by side inside a <Row>. */
interface Props {
  src?: string;
  poster?: string;
  caption?: string;
  placeholder?: string;
  height?: number;
  width?: number;
  alt?: string;
  fill?: boolean;
  grow?: number;
}
const { src, poster, caption, placeholder, height = 300, width, alt = '', fill = false, grow } = Astro.props;
const isVideo = src?.endsWith('.mp4') || src?.endsWith('.webm');
---
<figure class:list={['fig', { fill }]} style={grow ? `flex-grow:${grow}` : undefined}>
  {isVideo && <video src={src} poster={poster} muted loop playsinline preload="metadata" width={width}></video>}
  {src && !isVideo && <img src={src} alt={alt} loading="lazy" decoding="async" width={width} />}
  {!src && <div class="placeholder" style={`height:${height}px`} set:html={placeholder ?? 'drop media here'} />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin: 28px 0 0; flex: 1; min-width: 0; }
  .fig.fill { display: flex; flex-direction: column; }
  .fig.fill video { flex: 1; min-height: 0; object-fit: cover; }
  .fig img, .fig video {
    width: 100%; display: block; border-radius: 12px; border: 1.5px solid var(--line);
    transition: transform .35s var(--ease-pop), box-shadow .35s;
  }
  /* same lift-and-tilt as the phone frames — every lightboxable asset invites the tap */
  .fig img:hover, .fig video:hover {
    transform: translateY(-3px) rotate(-.4deg);
    box-shadow: 0 18px 44px rgba(60, 40, 20, .16);
  }
  .fig video { background: #111; }
  figcaption { font: 11px var(--font-sans); color: var(--t5); margin-top: 10px; }
</style>

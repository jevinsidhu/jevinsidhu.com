---
/* Margin doodle for "What I measured": a penciled magnifying glass that
   roams over the paragraphs — a few curious sweeps — then glides into the
   left margin and settles. Runs once on scroll via
   the shared [data-sketch]/[data-run] machinery. Hidden on narrow screens. */
interface Props { top?: number }
const { top = 1280 } = Astro.props;
---
<aside class="doodle" style={`top:${top}px`} data-sketch aria-hidden="true">
  <div class="mag">
    <svg viewBox="0 0 84 84" width="76">
      <!-- wobbly rim, drawn in one loose pass that overshoots -->
      <path class="lens" d="M34 14.5 c 11 -1.5 20 8 19.5 19 c -.5 11.5 -9 20.5 -20 19.8 c -10.5 -.6 -18.6 -9.3 -18 -19.8 c .6 -10 8 -18 17 -18.8 c 2.5 -.2 4.5 .1 6.5 .8" />
      <path class="glint" d="M23.5 29 q 3.5 -7.5 12 -9.5" />
      <!-- bowed handle, double stroke like a quick pencil pass -->
      <path class="handle" d="M48.5 50 q 8.5 7 15.5 15.5 m -14 -17 q 8 7.5 15 15" />
    </svg>
  </div>
</aside>

<style>
  .doodle { position: absolute; right: calc(100% + 40px); width: 90px; --pencil: color-mix(in srgb, color-mix(in srgb, var(--acc) 40%, var(--ink)) 66%, transparent); }
  .mag { opacity: 0; will-change: transform; }
  .lens, .handle { fill: none; stroke: var(--pencil); stroke-width: 2.4; stroke-linecap: round; }
  .glint { fill: none; stroke: color-mix(in srgb, var(--acc) 80%, var(--ink)); stroke-width: 2; stroke-linecap: round; }
  /* one gentle sweep over the text, then home to the margin */
  [data-run] .mag { animation: lensroam 1.9s cubic-bezier(.5, .1, .35, .95) forwards; }
  @keyframes lensroam {
    0% { opacity: 0; transform: translate(320px, -260px) rotate(-12deg); }
    12% { opacity: 1; }
    45% { transform: translate(180px, -140px) rotate(4deg); }
    100% { opacity: 1; transform: translate(0, 0) rotate(-8deg); }
  }
  @media (max-width: 1180px) { .doodle { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .mag, [data-run] .mag { animation: none; opacity: 1; transform: rotate(-8deg); }
  }
</style>

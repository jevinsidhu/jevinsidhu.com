---
/* Case-study hero: five filmstrip frames (the morph target of the home
   card's slices) with a glowing playhead and countdown timecode that sweep
   on their own and follow the cursor on hover. */
interface Props { thumb: string }
const { thumb } = Astro.props;
const frames = [0, 1, 2, 3, 4];
---
<div id="heroBand" class="band">
  <div id="heroStrip" class="strip">
    {frames.map((i) => (
      <div class="frH">
        <div class="img" transition:name={`slice-${i}`} style={`background-image:url(${thumb});background-position:${i * 25}% 50%`}></div>
        <div class="dimH"></div>
      </div>
    ))}
  </div>
  <div id="phH" class="playhead"></div>
  <div id="tcH" class="timecode">0:00</div>
</div>

<style>
  .band {
    --fw: min(136px, calc((100vw - 40px - 4 * 12px) / 5));
    --fh: calc(var(--fw) * 224 / 136);
    position: relative; height: calc(var(--fh) + 148px);
    background: radial-gradient(70% 120% at 50% -10%, rgba(var(--accrgb), .13), rgba(var(--accrgb), .03) 62%, transparent 100%), var(--bg);
  }
  .strip { position: absolute; top: 96px; left: 50%; transform: translateX(-50%); display: flex; gap: 12px; }
  .frH {
    width: var(--fw); height: var(--fh); border-radius: 12px; position: relative; background: #fff;
    box-shadow: 0 6px 14px rgba(43,43,34,.10), 0 20px 44px rgba(60,40,20,.13);
    transition: transform .3s cubic-bezier(.2,1.3,.4,1);
    will-change: transform;
  }
  .frH[data-lift] { transform: translateY(-16px) scale(1.06); }
  /* the lifted shadow is pre-rendered and crossfaded — animating box-shadow
     itself repaints every frame and stutters on iOS */
  .frH::after {
    content: ''; position: absolute; inset: 0; border-radius: 12px; pointer-events: none;
    box-shadow: 0 16px 30px rgba(43,43,34,.15), 0 38px 74px rgba(60,40,20,.22);
    opacity: 0; transition: opacity .3s;
  }
  .frH[data-lift]::after { opacity: 1; }
  .frH .img { position: absolute; inset: 6px; border-radius: 8px; background-size: 500% auto; background-repeat: no-repeat; pointer-events: none; }
  /* Dim starts invisible so it can't pop in when the morph snapshot lifts;
     it eases to its resting darkness once the transition has settled. */
  .dimH { position: absolute; inset: 0; border-radius: 12px; background: rgba(43,43,34,.28); opacity: 0; transition: opacity .6s ease; pointer-events: none; }
  .band[data-live] .dimH { opacity: 1; }
  .playhead {
    position: absolute; top: 62px; left: 0; width: 3px; height: calc(var(--fh) + 50px); border-radius: 2px; background: var(--acc);
    box-shadow: 0 0 14px rgba(var(--accrgb), .55); pointer-events: none; z-index: 6;
    opacity: 0; transition: opacity .45s ease; will-change: transform;
  }
  .band[data-live] .playhead, .band[data-live] .timecode { opacity: 1; }
  .timecode {
    position: absolute; top: 34px; left: 0; font: 500 12px var(--font-mono); color: var(--acc);
    pointer-events: none; z-index: 6;
    opacity: 0; transition: opacity .45s ease; will-change: transform;
  }
  @media (max-width: 780px) {
    /* no lift/scale on mobile — the passing playhead just brightens frames
       (the dim overlay easing to 0 is the highlight) */
    .frH, .frH[data-lift] { transform: none; transition: none; will-change: auto; }
    .frH::after { display: none; }
    /* smaller playhead, timecode beneath the strip */
    .playhead { top: 88px; height: calc(var(--fh) + 16px); width: 2.5px; }
    .timecode { top: calc(96px + var(--fh) + 14px); font-size: 10.5px; }
  }
</style>
